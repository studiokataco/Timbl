{
  "name": "timbl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.6",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:kill": "node scripts/dev-kill.mjs",
    "dev:next": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} FIREBASE_STORAGE_EMULATOR_HOST=${FIREBASE_STORAGE_EMULATOR_HOST:-127.0.0.1:9199} NEXT_PUBLIC_USE_EMULATORS=1 next dev",
    "dev:cloud": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "emulators": "firebase emulators:start --only firestore,auth,storage",
    "seed": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} tsx --require ./scripts/stub-server-only.cjs firestore/seeds/run.ts",
    "seed:platform": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} tsx --require ./scripts/stub-server-only.cjs scripts/seed-platform-admin.ts",
    "seed:platform-demo": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} tsx --require ./scripts/stub-server-only.cjs scripts/seed-platform-demo.ts",
    "seed:razorpay": "tsx --env-file=.env.local --require ./scripts/stub-server-only.cjs scripts/seed-razorpay-plans.ts",
    "backfill:plans": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} tsx --require ./scripts/stub-server-only.cjs scripts/backfill-org-plans.ts",
    "verify:billing": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} tsx --require ./scripts/stub-server-only.cjs scripts/verify-billing.ts",
    "grandfather:existing": "tsx --require ./scripts/stub-server-only.cjs scripts/grandfather-existing-orgs.ts",
    "test:rules": "firebase emulators:exec --only firestore --project timbl-rules-test \"vitest run\"",
    "test:smoke": "playwright test",
    "functions:build": "pnpm --dir functions build",
    "auth:configure": "bash scripts/configure-auth-domain.sh",
    "preflight:prod": "bash scripts/preflight-prod.sh",
    "secrets:bootstrap": "bash scripts/bootstrap-secrets.sh",
    "secrets:pull": "bash scripts/pull-secrets.sh",
    "secrets:rotate-resend": "bash scripts/rotate-secret.sh RESEND_API_KEY --env-local",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/timegrid": "^6.1.20",
    "@google/adk": "1.1.0",
    "@google/genai": "^2.1.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cronstrue": "^3.14.0",
    "csv-parse": "^6.2.1",
    "date-fns": "4.1.0",
    "driver.js": "^1.4.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "node-cron": "^4.2.1",
    "openai": "^6.38.0",
    "posthog-js": "^1.376.4",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "bcrypt": "^5.1.1",
    "posthog-node": "^4.0.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/string-similarity": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
