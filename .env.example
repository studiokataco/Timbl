# Social Media Planner - environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# Local dev (Phases 0-6 + 8) runs entirely against the Firebase Emulator
# Suite. The placeholder NEXT_PUBLIC_FIREBASE_* values below are sufficient.
#
# Production (Phase 7+) sources every variable below from Google Secret
# Manager via apphosting.yaml. NEVER copy a production credential into
# .env.local - keep prod values in Secret Manager only.

# Public - exposed to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=social-media-planner-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to route the app at the Firebase emulator suite. `pnpm dev` does
# this automatically. NEVER set this in production.
NEXT_PUBLIC_USE_EMULATORS=

# Server-only - used by the Admin SDK in server actions, seed scripts, and the
# CSV migration script. Single-line JSON of the service account credential.
# Leave unset to fall back to Application Default Credentials (works against
# the emulator when FIRESTORE_EMULATOR_HOST is exported).
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Emulator hosts - set these when running `firebase emulators:start`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---------------------------------------------------------------------------
# Agent runtime (lib/agents/**)
# ---------------------------------------------------------------------------

# AI Studio key for Gemini - the default model provider. Required for any
# non-mock agent run unless every agent is configured to use a different
# provider in /settings/agents. Also accepted: GOOGLE_GENAI_API_KEY,
# GOOGLE_API_KEY (same key, different env var names the adk-js client
# probes).
# Get one at https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Legacy/alternate name for the Gemini key - the registry reads either.
GOOGLE_API_KEY=

# Anthropic API key - used as fallback when GEMINI_API_KEY is not set, and
# for agents explicitly configured with provider=anthropic.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter API key - a single PLATFORM key (SAFE owns it). Used by any
# agent configured with provider=openrouter. OpenRouter speaks the
# OpenAI-compatible wire protocol; the openai-compatible adapter targets it.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama server base URL for provider=ollama (local open-weight models).
# Defaults to http://localhost:11434/v1 when unset. Ollama is dev/desktop
# only - Cloud Run cannot reach a localhost model, so the settings UI hides
# this provider on the hosted web build.
OLLAMA_BASE_URL=

# Shared secret consumed by /api/agents/cron/tick. The local agent-cron
# process and (Phase 7+) Cloud Scheduler both send this in the
# X-Agent-Cron-Secret header. Generate with `openssl rand -hex 32`.
AGENT_CRON_SECRET=

# When set to 1, the LLM registry returns a deterministic scripted model
# that reads from lib/agents/runtime/fixtures/*.json instead of calling a
# real provider. Used by /agent-browser verifications.
AGENT_MOCK_LLM=

# When set to 1, scripts/dev.mjs starts the local agent-cron process
# alongside the emulators + next dev.
AGENTS_CRON=

# ---------------------------------------------------------------------------
# Email (Resend) - team invites from /settings/team
# ---------------------------------------------------------------------------
# Paste your key only in .env.local (gitignored). Never commit it or paste it in chat.

# API key from https://resend.com/api-keys
# After rotating in Resend: pnpm secrets:rotate-resend  (updates GSM + .env.local)
RESEND_API_KEY=

# No product domain yet? Use Resend's built-in test sender + inbox (no DNS):
#   from onboarding@resend.dev  ->  to delivered@resend.dev
# Invites still save in Firestore; you read test mail in the Resend dashboard.
RESEND_TEST_MODE=1

# When you have a verified domain in Resend, turn test mode off and set:
# RESEND_TEST_MODE=
# RESEND_INVITE_FROM=SAFE Planner <noreply@yourdomain.com>

# ---------------------------------------------------------------------------
# Publishing layer (lib/publishing/**)
# ---------------------------------------------------------------------------

# Public origin of the app - OAuth redirect URIs are built from this and must
# match the value registered with each platform. Defaults to localhost in dev.
APP_BASE_URL=http://localhost:3000

# AES-256-GCM key source for the social-account token vault. ANY non-empty
# string boots the app locally; generate a real one with `openssl rand -hex 32`
# for prod (stored in Secret Manager, never committed).
SOCIAL_TOKEN_KEY=dev-social-token-key-change-me

# HMAC shared between the publishSweep Cloud Function and /api/publish/tick.
# Generate with `openssl rand -hex 32`.
PUBLISH_SWEEP_SECRET=dev-publish-sweep-secret-change-me

# Per-platform OAuth app credentials. Leave blank locally - connect flows
# only fire when a user clicks Connect. Required in prod for live publishing.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Embeddings (lib/embeddings/**)
# ---------------------------------------------------------------------------
# Resolves which provider embed() uses. Leave unset to auto-pick the first
# key that's present (gemini → voyage → openai), or set explicitly to one
# of: gemini | voyage | openai | mock. AGENT_MOCK_LLM=1 forces mock and
# wins over any value here - the same deterministic 64-d vector for the
# same text, no network.
EMBEDDING_PROVIDER=

# Voyage AI key. Defaults to model voyage-3-lite (512d).
# Get one at https://www.voyageai.com/
VOYAGE_API_KEY=

# OpenAI key for embeddings. Defaults to model text-embedding-3-small (1536d).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
