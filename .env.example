# Social Media Planner — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# Phases 0–6 + 8 run against the Firebase Emulator Suite locally.
# Real values land at Phase 7 when the production Firebase project is created.

# Public — exposed to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=social-media-planner-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only — used by the Admin SDK in server actions, seed scripts, and the
# CSV migration script. Single-line JSON of the service account credential.
# Leave unset to fall back to Application Default Credentials (works against
# the emulator when FIRESTORE_EMULATOR_HOST is exported).
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Emulator hosts — set these when running `firebase emulators:start`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
