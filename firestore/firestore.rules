rules_version = '2';

// Timbl - Firestore Security Rules.
//
// Multi-tenant model: every domain doc lives under
//   /organizations/{orgId}/...
// Reads and writes are gated on the request.auth.token.organizationId
// custom claim, set on every Firebase Auth user from their
// /organizations/{orgId}/users/{userId} membership.
//
// Most mutations go through the Admin SDK server-side and bypass these rules,
// but they are NOT dormant: client-SDK onSnapshot listeners (e.g. the calendar
// via lib/realtime/subscribe-posts.ts) read posts directly, so these rules are
// live for those reads today. Emulator tests also verify isolation here.
//
// Brand scoping is a document FIELD (brandId), not a path level - brands are
// isolated at the app-query layer, the same defense-in-depth posture as the
// organizationId field. Membership is org-level: every member sees all brands
// in their workspace. Per-brand access restriction is a deliberate future
// feature, not enforced here.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function token() {
      return request.auth.token;
    }
    function inOrg(orgId) {
      return isSignedIn() && token().organizationId == orgId;
    }
    function role() {
      return token().role;
    }
    function isAdminOrEditor() {
      return role() == 'admin' || role() == 'editor';
    }
    function isPlatformAdmin() {
      return isSignedIn() && token().platform == 'admin';
    }

    // --- Global: organizations -----------------------------------------
    // The org doc itself: members can read; only platform admins can write.
    match /organizations/{orgId} {
      allow read: if inOrg(orgId);
      allow write: if isPlatformAdmin();

      // --- Org-scoped subcollections ---------------------------------
      // Default: any member can read; admin/editor can write; contributors
      // are restricted further on `posts` (only update own assignments).
      match /{collection}/{docId} {
        allow read: if inOrg(orgId);
        allow create, delete: if inOrg(orgId) && isAdminOrEditor();
        allow update: if inOrg(orgId) && isAdminOrEditor();
      }

      // Tighter rules for posts: contributors can only update posts
      // assigned to them.
      match /posts/{postId} {
        allow read: if inOrg(orgId);
        allow create, delete: if inOrg(orgId) && isAdminOrEditor();
        allow update: if inOrg(orgId) && (
          isAdminOrEditor()
          || (role() == 'contributor'
              && resource.data.assigneeId == token().userId)
        );

        // Status history is append-only; the calling user must be in the
        // org and either editor+ or the post's assignee.
        match /statusHistory/{eventId} {
          allow read: if inOrg(orgId);
          allow create: if inOrg(orgId);
          allow update, delete: if false;
        }
      }

      // Publishing layer - token vault. Members may read account metadata
      // (the app never exposes the encrypted token fields to the client);
      // writes go through the Admin SDK / OAuth callback only.
      match /socialAccounts/{accountId} {
        allow read: if inOrg(orgId) && isAdminOrEditor();
        allow write: if false;
      }

      // Publish-attempt telemetry. Read-only for members; the worker writes
      // via the Admin SDK.
      match /publishRuns/{runId} {
        allow read: if inOrg(orgId);
        allow write: if false;
      }

      // OAuth app credentials for the publishing layer. Admins may read the
      // public projection (id, channel, audit fields) to detect whether a
      // platform is configured; the clientIdEnc/clientSecretEnc fields are
      // never returned to the client because the page reads via Admin SDK
      // and projects them out. Writes go through the setPlatformOauthApp
      // server action only.
      match /oauthApps/{channel} {
        allow read: if inOrg(orgId) && isAdminOrEditor();
        allow write: if false;
      }
    }

    // --- Global: awarenessDays -----------------------------------------
    // Curated cross-org calendar. Any signed-in user can read; only
    // platform admins can write.
    match /awarenessDays/{id} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // --- Global: platform (control centre) -----------------------------
    // The super-admin tree (allowlist, audit log, rollups, impersonation).
    // Platform admins may read; all writes go through the Admin SDK only,
    // so client writes are denied outright. This is the second defense
    // layer behind requirePlatformAdmin() in the app.
    match /platform/{document=**} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
  }
}
